QWidget {
    font-family: "Inter", "Arial";
    font-size: 10pt;
}

QLabel {
    background: transparent;
}

QLineEdit {
    border-radius: 10px;
    padding: 12px 16px;
}

QPushButton {
    border-radius: 10px;
    padding: 12px;
    font-weight: 700;
}

IconButton {
    background: transparent;
    background-color: transparent;
    border: none;
    min-height: 16px;
    min-width: 16px;
    border-radius: 8px;
    padding: 0px;
}

Button {
    border: none;
}