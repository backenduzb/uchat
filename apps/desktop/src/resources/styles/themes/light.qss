QWidget {
    background-color: #FFFFFF;
    color: #000000;
}

QLineEdit {
    background-color: transparent;
    color: #000000;
    selection-background-color: #000000;
    selection-color: #FFFFFF;
}

InputField {
    qproperty-normalBorderColor: #777777;
    qproperty-focusedBorderColor: #000000;
    qproperty-disabledBorderColor: #BBBBBB;
    qproperty-placeholderColor: #767676;
}

QPushButton {
    background-color: #000000;
    color: #FFFFFF;
    border-color: #000000;
}

QPushButton:hover {
    background-color: #333333;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #555555;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #FFFFFF;
    color: #777777;
    border-color: #777777;
}

Button {
    color: #FFFFFF;
    qproperty-normalBackground: #000000;
    qproperty-hoverBackground: #333333;
    qproperty-pressedBackground: #555555;
    qproperty-disabledBackground: #E5E5E5;
}

Button:disabled {
    color: #777777;
}

TopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E5E5;
}

TopBar QWidget#topBarSearchBox {
    background-color: #F0F0F0;
    border-color: #F0F0F0;
}

TopBar QLineEdit#topBarSearchInput {
    color: #000000;
    selection-background-color: #000000;
    selection-color: #FFFFFF;
}

TopBar QLabel#topBarSearchIcon {
    color: #767676;
}

IconButton {
    color: #555555;
    qproperty-iconColor: #555555;
    qproperty-rippleColor: rgba(0, 0, 0, 40);
}

Button {
    qproperty-rippleColor: rgba(255, 255, 255, 70);
}

MenuDrawer QWidget#menuPanel {
    background-color: #FFFFFF;
}

MenuDrawer QLabel#menuAvatar {
    background-color: #000000;
    color: #FFFFFF;
}

MenuDrawer QLabel#menuName {
    color: #000000;
}

MenuDrawer QLabel#menuUsername {
    color: #767676;
}

MenuDrawer QLabel#menuSectionTitle {
    color: #000000;
}

MenuDrawer QWidget#menuSeparator {
    background-color: #E5E5E5;
}

Button#menuItemButton {
    color: #000000;
    qproperty-normalBackground: #F0F0F0;
    qproperty-hoverBackground: #E4E4E4;
    qproperty-pressedBackground: #D4D4D4;
    qproperty-disabledBackground: #E5E5E5;
}

QLabel#errorLabel {
    color: #FF0000;
}

QPushButton#themeDark {
    background-color: #000000;
}

QPushButton#themeLight {
    background-color: #FFFFFF;
    border: 1px solid #777777;
}
